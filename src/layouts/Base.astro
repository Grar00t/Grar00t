---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sulaiman Alshammari — Grar00t',
  description = 'Systems, security, local-first computing, and evidence-first technical writing by Sulaiman Alshammari.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark" data-theme-mode="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const allowed = new Set(['dark', 'light', 'system']);
        let mode = 'system';
        try {
          const stored = localStorage.getItem('theme-mode') || localStorage.getItem('theme');
          if (stored && allowed.has(stored)) mode = stored;
        } catch {}

        const resolved = mode === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : mode;

        root.dataset.themeMode = mode;
        root.dataset.theme = resolved;
        root.style.colorScheme = resolved;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          resolved === 'dark' ? '#07090d' : '#faf9f6'
        );
      })();
    </script>
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>
    <header class="site-header">
      <a class="mark" href={base} aria-label="Grar00t home">
        <span class="mark-dot"></span>
        <span>GRAR00T</span>
      </a>
      <nav aria-label="Primary">
        <a href={`${base}essays/`}>Writing</a>
        <a href={`${base}#work`}>Work</a>
        <a href={`${base}#principles`}>Principles</a>
        <a href="mailto:iqd@hotmail.com">Contact</a>
      </nav>
      <ThemeToggle client:load />
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Sulaiman Alshammari</strong>
        <span>Riyadh, Saudi Arabia</span>
      </div>
      <div class="footer-links">
        <a href="https://github.com/Grar00t">GitHub</a>
        <a href="mailto:iqd@hotmail.com">iqd@hotmail.com</a>
      </div>
    </footer>
  </body>
</html>
